# Server
PORT=3000
NODE_ENV=development

# DeepSeek (required for chat — keep the real key only in local .env, never commit it)
# Get a key from https://platform.deepseek.com/ then set:
#   DEEPSEEK_API_KEY=sk-...
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Upload / session
UPLOAD_MAX_BYTES=10485760
UPLOAD_DIR=./uploads
SESSION_TTL_MS=7200000
ALLOWED_EXTENSIONS=.xlsx,.xls,.csv

# Chat grounding
CHAT_SAMPLE_ROWS=30
CHAT_MAX_CONTEXT_CHARS=48000
CHAT_HISTORY_TURNS=10
